# Example of .env properties
POSTGRES_URL=jdbc:postgresql://venue-db:5432/example_db
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password
POSTGRES_DB=example_db
SERVER_HOST_PORT=8081
GRPC_HOST_PORT=9091
SPRING_GRPC_SERVER_PORT=9090
DISH_SYNC_TRANSPORT=grpc
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_PROFILE=default
OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
